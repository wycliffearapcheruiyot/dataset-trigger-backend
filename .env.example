# Copy to .env for local runs (export them, or use `set -a; source .env; set +a`).
# On Render, set these in the dashboard instead.

# Auth for the endpoints (callers send it as the X-Webhook-Secret header)
DATASET_TRIGGER_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dataset_backend

# Kaggle account that owns the dataset
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
KAGGLE_DATASET=your-kaggle-username/your-dataset-slug

# Hugging Face repo to copy into that Kaggle dataset
HF_REPO_ID=org/repo-name

# Optional
# HF_REVISION=main
# HF_TOKEN=hf_xxx                      only if HF_REPO_ID is private/gated
# DATASET_TITLE=My Dataset
# DATASET_EXPECTED_FILE=model.safetensors
# DATASET_KERNEL_SLUG=hf-to-kaggle-dataset
# DATASET_SECRETS_SLUG=dataset-trigger-secrets   private Kaggle dataset used to
#                                                 hand the Kaggle key/HF token to
#                                                 the kernel (created automatically)
# DATASET_PREPARE_TIMEOUT_MINUTES=90
